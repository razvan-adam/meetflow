# MeetFlow .gitignore

# --- Secrets and environment config (never commit) ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials.json

# --- Local data (meeting content is customer data; GDPR) ---
*.sqlite
*.sqlite3
*.db
*.dump
*.sql.gz
data/
backups/
uploads/

# --- Logs ---
logs/
*.log

# --- Tests and coverage ---
coverage/
test-results/
*.lcov

# --- Build output ---
dist/
build/
out/

# --- Temporary files ---
tmp/
temp/
*.tmp
*.bak

# --- Editors and IDEs ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# --- OS files ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Private discovery notes (market research, customer interviews) ---
docs/discovery/

# --- Personal planning notes ---
NEXT-STEPS.md

# --- Backend (Java, Maven) ---
target/
.mvn/wrapper/maven-wrapper.jar
*.iml

# --- Frontend (Node.js, Vite) ---
node_modules/
*.tsbuildinfo
*.local

# --- Infrastructure (Terraform) ---
# Provider downloads and state stay local; .terraform.lock.hcl is committed.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
