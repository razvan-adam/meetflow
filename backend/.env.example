# Backend settings. Copy to backend/.env for local overrides; .env is git-ignored and must never be committed.
# The file is read as Spring properties. Deployed environments set the same settings as environment
# variables instead (spring.datasource.url -> SPRING_DATASOURCE_URL), with values from AWS Secrets Manager.
#
# Local development needs none of these: `npm run dev` starts PostgreSQL from compose.yaml
# (Docker must be running) and connects to it automatically.

# --- Database (required when not using the local Docker Compose database) ---
# Set to false to use the database below instead of starting compose.yaml.
spring.docker.compose.enabled=true
spring.datasource.url=jdbc:postgresql://localhost:5432/meetflow
spring.datasource.username=meetflow
spring.datasource.password=

# --- Server ---
server.port=8080
